# Server
SERVER_PORT=8080

# MariaDB
SHOP_DB_HOST=localhost
SHOP_DB_PORT=3306
SHOP_DB_NAME=shop_local
SHOP_DB_USERNAME=shop_app
SHOP_DB_PASSWORD=replace-with-db-password

# Uploaded item images
SHOP_UPLOAD_ROOT=/home/ec2-user/shop/uploads

# Gmail
SHOP_MAIL_USERNAME=your-gmail@example.com
SHOP_MAIL_PASSWORD=replace-with-google-app-password

# OAuth (optional until each login provider is enabled)
SHOP_GOOGLE_CLIENT_ID=
SHOP_GOOGLE_CLIENT_SECRET=
SHOP_NAVER_CLIENT_ID=
SHOP_NAVER_CLIENT_SECRET=
SHOP_KAKAO_CLIENT_ID=
SHOP_KAKAO_CLIENT_SECRET=

# Optional external integrations
OPEN_AI_KEY=
KAKAO_ADMIN_KEY=